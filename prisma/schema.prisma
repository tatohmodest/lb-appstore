generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Category {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  // lucide icon name, e.g. "wallet"
  icon      String   @default("sparkles")
  // two hex colors used for the category gradient
  colorFrom String   @default("#7c3aed")
  colorTo   String   @default("#2563eb")
  order     Int      @default(0)
  apps      App[]
  createdAt DateTime @default(now())
}

model App {
  id            String   @id @default(cuid())
  slug          String   @unique
  name          String
  subtitle      String   @default("")
  description   String   @default("")
  // one-line hook used on Today cards
  headline      String?
  developer     String   @default("LoopingBinary")
  // where the PWA lives - "Get" sends people here
  url           String
  manifestUrl   String?
  iconUrl       String?
  coverUrl      String?
  screenshots   String[]
  accentColor   String   @default("#00b369")
  version       String   @default("1.0.0")
  whatsNew      String   @default("")
  sizeKb        Int      @default(0)
  ageRating     String   @default("4+")
  // browser capabilities the app asks for, e.g. "Camera", "Notifications"
  permissions   String[]
  tags          String[]
  // supports offline use (service worker cached)
  offline       Boolean  @default(true)
  featured      Boolean  @default(false)
  editorsChoice Boolean  @default(false)
  published     Boolean  @default(true)
  installs      Int      @default(0)
  ratingAvg     Float    @default(0)
  ratingCount   Int      @default(0)
  categoryId    String?
  category      Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  reviews       Review[]
  events        InstallEvent[]
  releasedAt    DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([published, featured])
  @@index([categoryId])
}

model Review {
  id        String   @id @default(cuid())
  appId     String
  app       App      @relation(fields: [appId], references: [id], onDelete: Cascade)
  author    String
  rating    Int
  title     String   @default("")
  body      String   @default("")
  // anonymous per-device id so one device = one review per app
  deviceId  String
  reply     String?
  createdAt DateTime @default(now())

  @@unique([appId, deviceId])
  @@index([appId, createdAt])
}

model InstallEvent {
  id        String   @id @default(cuid())
  appId     String
  app       App      @relation(fields: [appId], references: [id], onDelete: Cascade)
  // ios | android | desktop | other
  platform  String
  createdAt DateTime @default(now())

  @@index([appId, createdAt])
}
